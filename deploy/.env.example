# ============================================================================
# SyncMídia self-hosted — modelo de variáveis de ambiente
#
# Uso:  cp .env.example .env   (na pasta deploy/, ao lado do docker-compose.yml)
#       → preencha TODOS os valores marcados como OBRIGATÓRIO
#       → .env nunca vai para o git
#
# Geração de segredos (resumo; detalhes no deploy/README.md):
#   sh supabase/utils/generate-keys.sh --update-env   # JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY
#   openssl rand -hex 24                              # senhas/segredos genéricos
# ============================================================================

# ----------------------------------------------------------------------------
# Domínios (obrigatório) — Caddy usa estes valores no Caddyfile.
# Os dois registros DNS (A) devem apontar para o IP do VPS.
# ----------------------------------------------------------------------------
APP_DOMAIN=app.<dominio>
SUPABASE_DOMAIN=supabase.<dominio>

# ----------------------------------------------------------------------------
# App SyncMídia (obrigatório)
# ----------------------------------------------------------------------------
# URL pública da API Supabase e chave pública — fixadas no build da imagem
# (build-args) e reutilizadas como SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY em runtime.
# Deve ser IGUAL a SUPABASE_PUBLIC_URL (abaixo).
VITE_SUPABASE_URL=https://supabase.<dominio>
# Chave anon (HS256, gerada por generate-keys.sh) — o valor de ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Segredo das rotas de cron do app (header Authorization: Bearer <valor>).
# Obrigatório para o container do app subir.
CRON_SECRET=
# Opcional: segredo anterior, durante rotação (ambos são aceitos).
CRON_SECRET_PREVIOUS=

# Opcional: webhook de notificações (VITE_NOTIFY_WEBHOOK_URL).
# Sem valor, os envios de notificação são simulados no app.
VITE_NOTIFY_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# Stack Supabase — segredos (obrigatório: TROQUE TUDO antes do primeiro up)
# ----------------------------------------------------------------------------
# Postgres: usar apenas [a-z0-9] (openssl rand -hex 24) — a senha entra em
# URLs de conexão (postgres://...) e caracteres especiais quebram o parse.
POSTGRES_PASSWORD=

# Chaves legadas HS256 — gere com:
#   cd deploy && sh supabase/utils/generate-keys.sh --update-env
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Acesso ao Studio (via túnel SSH — README §3.9). Troque a senha!
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# Encriptação de comunicações internas (>= 64 chars: openssl rand -base64 48)
SECRET_KEY_BASE=
# Encriptação de campos sensíveis do Realtime (exatamente 16: openssl rand -hex 8)
REALTIME_DB_ENC_KEY=supabaserealtime
# Encriptação de configuração do Supavisor (exatamente 32: openssl rand -hex 16)
VAULT_ENC_KEY=
# Encriptação de connection strings no Studio/pg-meta (>= 32: openssl rand -base64 24)
PG_META_CRYPTO_KEY=

# S3 protocol endpoint do Storage (openssl rand -hex 16 / -hex 32)
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# ----------------------------------------------------------------------------
# Stack Supabase — URLs (obrigatório)
# ----------------------------------------------------------------------------
# URL pública da API (SEM caminho). Igual à VITE_SUPABASE_URL.
SUPABASE_PUBLIC_URL=https://supabase.<dominio>
# URL externa do serviço de Auth — PRECISA terminar em /auth/v1.
# O callback do Google fica: https://supabase.<dominio>/auth/v1/callback
API_EXTERNAL_URL=https://supabase.<dominio>/auth/v1

# ----------------------------------------------------------------------------
# Stack Supabase — banco e pooler
# ----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
# NÃO ALTERE: a porta é usada dentro dos containers (PGPORT) e nas URLs de
# conexão internas; o compose.ports.yml apenas a prende ao loopback no host.
POSTGRES_PORT=5432

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
# Identificador único do tenant do pooler (openssl rand -hex 8)
POOLER_TENANT_ID=
POOLER_DB_POOL_SIZE=5

# ----------------------------------------------------------------------------
# Stack Supabase — Studio
# ----------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=SyncMídia
STUDIO_DEFAULT_PROJECT=SyncMídia
# Opcional: habilita o AI Assistant do Studio.
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Stack Supabase — Auth (GoTrue)
# ----------------------------------------------------------------------------
SITE_URL=https://app.<dominio>
# Opcional: URLs extras permitidas como redirectTo (padrões com curinga).
# Ex.: https://app.<dominio>/**
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

# Caminhos dos links dos e-mails (mantenha o padrão — o gateway roteia /auth/v1).
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# E-mail: OBRIGATÓRIO em produção — sem SMTP o cadastro/resets não enviam.
# (README §3.5; validação antes do teste de cadastro — README §6)
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=
ENABLE_ANONYMOUS_USERS=false

# Telefone (não usado pelo app — mantenha os padrões).
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

# Google OAuth — preencha E descomente as 4 linhas GOTRUE_EXTERNAL_GOOGLE_*
# no supabase/docker-compose.yml (README §3.6).
# Redirect a cadastrar no Google Cloud Console:
#   https://supabase.<dominio>/auth/v1/callback
#GOOGLE_ENABLED=true
#GOOGLE_CLIENT_ID=
#GOOGLE_SECRET=

# Outros provedores/métodos opcionais (não usados pelo app; só descomente
# se for habilitar o grupo correspondente no supabase/docker-compose.yml —
# lista completa: supabase/.env.example e supabase/CONFIG.md do tag fixado).
#GITHUB_ENABLED=false
#GITHUB_CLIENT_ID=
#GITHUB_SECRET=
#AZURE_ENABLED=false
#AZURE_CLIENT_ID=
#AZURE_SECRET=
#SMS_PROVIDER=
#SMS_OTP_EXP=60
#SMS_OTP_LENGTH=6
#SMS_MAX_FREQUENCY=60s
#SMS_TEMPLATE=
#SMS_TWILIO_ACCOUNT_SID=
#SMS_TWILIO_AUTH_TOKEN=
#SMS_TWILIO_MESSAGE_SERVICE_SID=
#SMS_TEST_OTP=
#MFA_TOTP_ENROLL_ENABLED=true
#MFA_TOTP_VERIFY_ENABLED=true
#MFA_PHONE_ENROLL_ENABLED=false
#MFA_PHONE_VERIFY_ENABLED=false
#MFA_MAX_ENROLLED_FACTORS=10
#SAML_ENABLED=true
#SAML_PRIVATE_KEY=
#SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
#SAML_EXTERNAL_URL=
#SAML_RATE_LIMIT_ASSERTION=15
#SAML_RELAY_STATE_VALIDITY_PERIOD=2m0s

# ----------------------------------------------------------------------------
# Stack Supabase — Storage / Functions / REST
# ----------------------------------------------------------------------------
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

FUNCTIONS_VERIFY_JWT=false

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ----------------------------------------------------------------------------
# Stack Supabase — gateway e imgproxy
# ----------------------------------------------------------------------------
# Porta de host do gateway (Envoy) — usada pelo compose.ports.yml, sempre
# presa ao loopback (127.0.0.1). O acesso público passa pelo Caddy.
API_GW_HTTP_PORT=8000

IMGPROXY_AUTO_WEBP=true

# ----------------------------------------------------------------------------
# Opcional — chaves de API novas (opacas) e JWKs assimétricas.
# Sem elas, a stack usa as chaves legadas HS256 geradas acima.
# Gere com: sh supabase/utils/add-new-auth-keys.sh
# (documentação: https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys)
# ----------------------------------------------------------------------------
#SUPABASE_PUBLISHABLE_KEY=
#SUPABASE_SECRET_KEY=
#JWT_KEYS=
#JWT_JWKS=
#ANON_KEY_ASYMMETRIC=
#SERVICE_ROLE_KEY_ASYMMETRIC=
